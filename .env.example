# Mot de passe de connexion à OrbitOS (obligatoire, long et unique)
ORBIT_PASSWORD=change-moi-avec-un-long-mot-de-passe
# Port local d'accès : http://localhost:8080
ORBIT_HTTP_PORT=8080
# Noms d'hôte acceptés (séparés par des virgules), ex. orbitos.example.com derrière un reverse proxy
ORBIT_HOSTS=localhost,127.0.0.1
# Dossier SSH monté en lecture seule (config, known_hosts, clés)
# ORBIT_SSH_DIR=/opt/orbitos/ssh   (défaut : ~/.ssh)
# 1 = lecture seule : aucune action ne modifie les serveurs
ORBIT_READONLY=0
# Fuseau horaire du conteneur
TZ=Etc/UTC
